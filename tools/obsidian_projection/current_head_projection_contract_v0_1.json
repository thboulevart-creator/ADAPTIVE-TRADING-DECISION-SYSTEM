  "objective": {
    "name": "CURRENT_HEAD_DETERMINISTIC_PROJECTION",
    "purpose": "Define a deterministic current-head projection builder and relation adapter over qualified P5-D3B bridge output without FrozenInventory, pilot source counts, or METADATA_ONLY body reads.",
    "one_artifact_per_bridge_entry": true,
    "fixed_source_count_forbidden": true,
    "pilot_inventory_semantics_forbidden": true,
    "frozen_inventory_conversion_forbidden": true,
    "source_body_copying_forbidden": true,
    "live_vault_write_forbidden": true,
    "current_pointer_write_forbidden": true
  },
  "input_contract": {
    "required_bridge_schema": "ATDS_OBSIDIAN_CURRENT_HEAD_SEMANTIC_BRIDGE_RESULT_V0_1",
    "required_entry_schema": "ATDS_OBSIDIAN_CURRENT_HEAD_SEMANTIC_BRIDGE_ENTRY_V0_1",
    "required_semantic_record_schema": "ATDS_OBSIDIAN_SEMANTIC_RECORD_V0_1",
    "repository_must_equal_contract_repository": true,
    "branch_must_equal_contract_branch": true,
    "bridge_source_commit_is_candidate_head": true,
    "bridge_source_tree_is_candidate_tree": true,
    "bridge_dynamic_inventory_digest_required": true,
    "bridge_entry_digest_required": true,
    "semantic_record_digest_required": true,
    "bridge_entries_bytewise_source_path_sorted": true,
    "duplicate_source_path_forbidden": true,
    "artifact_count_must_equal_bridge_entry_count": true,
    "empty_bridge_forbidden": true
  },
  "body_read_authority": {
    "default": "DENY",
    "metadata_only_body_read_allowed": false,
    "artifact_render_body_read_allowed": false,
    "relation_body_read_allowed_only_when": {
      "content_mode": "FULL_TEXT",
      "downstream_body_read_allowed": true,
      "source_suffix_in": [
        ".md",
        ".json"
      ]
    },
    "full_text_non_relation_suffix_body_read_allowed": false,
    "metadata_only_may_be_relation_target": true,
    "metadata_only_may_be_relation_source": false,
    "body_read_must_use_exact_bridge_blob_sha": true,
    "body_read_source_path_and_blob_binding_required": true,
    "unregistered_blob_read_forbidden": true,
    "body_read_audit_required": true,
    "body_read_audit_order": "source_path UTF-8 bytewise ASC",
    "body_read_audit_fields": [
      "source_path",
      "source_blob_sha",
      "content_mode",
      "purpose"
    ],
    "body_read_audit_digest_algorithm": "SHA256 canonical JSON rows",
    "metadata_only_body_read_count_must_equal": 0
  },
  "markdown_serialization": {
    "encoding": "UTF-8",
    "bom": false,
    "newline": "LF",
    "final_newline": true,
    "frontmatter_scalar_encoding": "JSON_DOUBLE_QUOTED_STRING",
    "frontmatter_array_encoding": "JSON_COMPACT_ARRAY",
    "null_encoding": "null",
    "boolean_encoding": [
      "true",
      "false"
    ],
    "integer_encoding": "BASE10_NO_LEADING_PLUS",
    "unknown_extra_fields": "BLOCK_BUILD",
    "source_text_copying": "FORBIDDEN",
    "wikilink_generation": "FORBIDDEN"
  },
  "ordering": {
    "bridge_input_order": "source_path ASC UTF-8 bytewise",
    "artifact_output_order": "projection_record_id ASC bytewise ASCII",
    "relation_output_order": "projection_relation_id ASC bytewise ASCII",
    "manifest_file_order": "relative_path ASC UTF-8 bytewise",
    "body_read_audit_order": "source_path ASC UTF-8 bytewise"
  },
  "path_safety": {
    "allowed_generated_roots": [
      "generated/artifacts",
      "generated/relations",
      "generated/manifests"
    ],
    "forbidden_builder_write_roots": [
      "views",
      ".obsidian"
    ],
    "forbidden_pointer_names": [
      "CURRENT",
      "CURRENT.md",
      "CURRENT.json",
      "CURRENT.tmp"
    ],
    "filename_source": "DETERMINISTIC_RECORD_ID_ONLY",
    "source_path_used_as_output_path": false,
    "path_separator": "/"
  },
  "staging": {
    "location": "OS_TEMP_ONLY",
    "fresh_empty_directory_required": true,
    "preexisting_target_policy": "BLOCK",
    "file_creation_mode": "CREATE_NEW_EXCLUSIVE",
    "overwrite_in_place": false,
    "symlink_junction_reparse_escape": "BLOCK",
    "hard_link_count_expected": 1,
    "hard_link_check_unavailable": "BLOCK",
    "builder_write_outside_staging": "BLOCK",
    "real_vault": false,
    "promotion": "NOT_AUTHORIZED"
