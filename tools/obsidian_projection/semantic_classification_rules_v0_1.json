  "path_filename_policy": {
    "allowed_uses": [
      "locate exact frozen inventory record",
      "derive physical artifact_family when combined with frozen inventory_class and extension",
      "select a candidate parser without committing semantic state"
    ],
    "forbidden_final_axes": [
      "semantic_role",
      "procedure_role",
      "qualification_status",
      "qualification_scope",
      "scientific_status",
      "epistemic_role",
      "temporal_role",
      "limitations",
      "non_claims"
    ],
    "exact_override_exception": "An exact source_path may participate only when the same rule also requires the exact frozen source_blob_sha."
  },
  "evidence_precedence": [
    "EXACT_GIT_IDENTITY",
    "FROZEN_PILOT_INVENTORY",
    "EXPLICIT_STRUCTURED_CONTENT",
    "EXPLICIT_LABELED_CONTENT",
    "EXACT_BLOB_OVERRIDE",
    "UNKNOWN"
  ],
  "axis_rules": {
    "artifact_family": {
      "basis": "PHYSICAL_ONLY",
      "rules": [
        {
          "inventory_class": "IMPLEMENTATION",
          "extension": ".py",
          "value": "CODE"
        },
        {
          "inventory_class": "TEST",
          "extension": ".py",
          "value": "TEST"
        },
        {
          "inventory_class": "BREAKER",
          "extension": ".py",
          "value": "BREAKER"
        },
        {
          "inventory_class": "EVIDENCE",
          "value": "EVIDENCE"
        },
        {
          "inventory_class": "CORE_PROFILE",
          "extension": ".json",
          "value": "EVIDENCE"
        },
        {
          "extension": ".md",
          "value": "DOCUMENT"
        }
      ]
    },
    "authority_role": {
      "default": "UNKNOWN",
      "rules": [
        {
          "value": "CANONICAL",
          "requires": [
            "FROZEN_INVENTORY_MEMBER",
            "EXACT_GIT_BLOB_MATCH",
            "TRACKED_IN_FROZEN_TREE"
          ]
        }
      ],
      "non_implications": [
        "qualified",
        "PASS",
        "normative",
        "current",
        "scientifically_supported"
      ]
    },
    "persistence_state": {
      "default": "UNKNOWN",
      "rules": [
        {
          "value": "TRACKED_IN_GIT_TREE",
          "requires": [
            "FROZEN_INVENTORY_MEMBER",
            "EXACT_GIT_BLOB_MATCH",
            "TRACKED_IN_FROZEN_TREE"
          ]
        }
      ]
    },
    "semantic_role": {
      "default": "UNKNOWN",
      "allowed_evidence": [
        "EXPLICIT_STRUCTURED_CONTENT",
        "EXPLICIT_LABELED_CONTENT",
        "EXACT_BLOB_OVERRIDE"
      ],
      "title_or_filename_alone_sufficient": false
    },
    "procedure_role": {
      "default": "NONE",
      "allowed_evidence": [
        "EXPLICIT_LABELED_CONTENT",
        "EXACT_BLOB_OVERRIDE"
      ],
      "content_signatures": {
        "PREFLIGHT": [
          "explicit purpose/scope",
          "explicit prohibitions or gates",
          "terminal verdict scoped to preflight"
        ],
        "ADVERSARIAL_REVIEW": [
          "explicit attacks/review body",
          "terminal verdict scoped to reviewed candidate"
        ],
        "ADJUDICATION": [
          "explicit evidence/inputs or promotion gate",
          "explicit terminal verdict"
        ],
        "HANDOFF": [
          "explicit transfer/next-action body",
          "EXACT_BLOB_OVERRIDE or HISTORICAL_LINEAGE content signature"
        ],
        "TEST_RESULT": [
          "structured test/mutation result content"
        ],
        "EXECUTION": [
          "explicit attempt/run result content"
        ]
      }
    },
    "qualification_status": {
      "default": "UNKNOWN",
      "allowed_values": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "generic_terminal_rule": {
        "allowed_procedure_roles": [
          "ADJUDICATION",
          "PREFLIGHT",
          "ADVERSARIAL_REVIEW"
        ],
        "requires": [
          "EXPLICIT_TERMINAL_VERDICT_BLOCK",
          "QUALIFICATION_SCOPE_FROM_SAME_SOURCE"
        ],
        "forbids_as_sufficient": [
          "FILENAME_TOKEN",
          "PATH_TOKEN",
          "TITLE_ONLY",
          "BODY_MENTION_ONLY",
          "MACHINE_STATUS_ONLY",
          "TEST_PASS_ONLY",
          "MUTANT_KILLED_ONLY",
          "WORKFLOW_SUCCESS_ONLY",
          "PROFILE_SELF_STATUS_ONLY",
          "HANDOFF_REPORTED_VERDICT_ONLY"
        ]
      },
      "bounded_exception_rule": {
        "requires": [
          "EXACT_SOURCE_PATH",
          "EXACT_SOURCE_BLOB_SHA",
          "EXPLICIT_ATTEMPT_STATUS_IN_CONTENT",
          "EXPLICIT_FAILURE_OR_BLOCKING_CONTEXT"
        ],
        "purpose": "Represent known historical blocked attempts that have no terminal Verdict section without creating a generic status heuristic."
      }
    },
    "qualification_scope": {
      "default": null,
      "rule": "MUST be extracted or preregistered from the same authoritative source that supplies qualification_status; never inherited from filename or neighboring record."
    },
    "scientific_status": {
      "default": "UNKNOWN",
      "allowed_values": [
        "SUPPORTED",
        "REFUTED",
        "NOT_INTERPRETABLE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "rule": "Only explicit scientific-decision content may set this axis. qualification_status never maps to scientific_status."
    },
    "epistemic_role": {
      "default": "UNKNOWN",
      "allowed_values": [
        "OBSERVATION",
        "DESCRIPTION",
        "HYPOTHESIS",
        "TEST",
        "RESULT",
        "VALIDATED_KNOWLEDGE",
        "REJECTED_HYPOTHESIS",
        "UNKNOWN"
      ],
      "rule": "Requires explicit epistemic declaration/content signature or exact blob override."
    },
    "temporal_role": {
      "default": "UNKNOWN",
      "historical_rule": {
        "value": "HISTORICAL",
        "requires": [
          "FROZEN_INVENTORY_CLASS_HISTORICAL_LINEAGE",
          "SESSION_OR_ATTEMPT_CONTENT_SIGNATURE"
        ]
      },
      "current_rule": {
        "automatic_assignment": false,
        "reason": "Latest date/version/commit/path/backlinks do not establish CURRENT."
      }
    },
    "limitations": {
      "default": [],
      "allowed_sources": [
        "DEDICATED_LIMITATIONS_SECTION",
        "EXACT_STRUCTURED_LIMITATION_FIELD",
        "EXACT_BLOB_OVERRIDE"
      ],
      "generic_negation_scraping_allowed": false
    },
    "non_claims": {
      "default": [],
      "allowed_sources": [
        "DEDICATED_NON_PROMOTIONS_SECTION",
        "EXPLICIT_SCOPE_NEGATIVE_LIST",
        "TERMINAL_VERDICT_BOUNDARY_TEXT",
        "EXACT_BLOB_OVERRIDE"
      ],
      "generic_negation_scraping_allowed": false
    }
  },
  "forbidden_promotions": [
