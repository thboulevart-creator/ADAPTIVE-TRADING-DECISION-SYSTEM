    },
    {
      "id": "SI01-C04",
      "decision": "AMEND",
      "adopted_name": "UTC_YEAR_DISTRIBUTIONAL_VARIATION_CANDIDATE",
      "adopted_statement": "Within the admitted 2021-05-25 through 2026-05-24 corpus, the predeclared UTC_YEAR bucket distributions differ descriptively across years for minute_range, tick_count, and spread_mean. The 2025-2026 spread_mean central quantiles differ sharply from earlier year buckets while p99 remains near prior-year levels. This is a retrospective descriptive variation candidate only; formal temporal instability, nonstationarity, structural break, cause, persistence, and generalization remain untested.",
      "exploratory_search": true
    },
    {
      "id": "SI01-C05",
      "decision": "ADOPT",
      "adopted_name": "PREDECLARED_TIME_SUPPORT_IS_INCOMPLETE",
      "adopted_statement": "The admitted corpus has incomplete support across the full predeclared New York calendar grid; empty buckets are explicit rather than numerically imputed.",
      "exploratory_search": false
    }
